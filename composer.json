{
  "name": "jord-jd/php-countries",
  "description": "🌍 PHP Countries is a library that provides an elegant syntax to country data.",
  "type": "library",
  "require": {
    "php": "^7.1||^8.0",
    "mledoze/countries": "^4.0||^5.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^7.5 || ^9.6 || ^10.5 || ^11.5 || ^12.0"
  },
  "license": "LGPL-3.0-only",
  "authors": [
    {
      "name": "Jordan Hall",
      "email": "jordan@hall05.co.uk"
    }
  ],
  "autoload": {
    "psr-4": {
      "JordJD\\Countries\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JordJD\\Countries\\Tests\\": "tests/Unit/"
    }
  },
  "replace": {
    "divineomega/php-countries": "self.version"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "4.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "kylekatarnls/update-helper": false
    }
  }
}
